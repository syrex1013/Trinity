SCHEMA = """CREATE TABLE IF NOT EXISTS jobs (
 id INTEGER PRIMARY KEY, source TEXT NOT NULL, release_url TEXT NOT NULL UNIQUE,
 package TEXT, version TEXT, download_path TEXT, sha256 TEXT, report_path TEXT,
 status TEXT NOT NULL DEFAULT 'discovered', retries INTEGER NOT NULL DEFAULT 0,
 error TEXT, created_at REAL NOT NULL, updated_at REAL NOT NULL
); CREATE INDEX IF NOT EXISTS jobs_status ON jobs(status);"""
SECRETS_SCHEMA = """CREATE TABLE IF NOT EXISTS secrets (
 id INTEGER PRIMARY KEY, job_id INTEGER NOT NULL REFERENCES jobs(id),
 detector TEXT NOT NULL, value TEXT NOT NULL, file TEXT NOT NULL, verified INTEGER,
 working INTEGER, created_at REAL NOT NULL, UNIQUE(job_id, detector, value, file)
); CREATE INDEX IF NOT EXISTS secrets_job ON secrets(job_id);"""
TRANSIENT = ("downloading", "scanning")


class Error(RuntimeError): pass


class Store:
    def __init__(self, root: Path):
        self.root = root
        root.mkdir(parents=True, exist_ok=True)
        os.chmod(root, 0o700)
        for name in ("apks", "reports"):
            (root / name).mkdir(exist_ok=True)
        self.db = sqlite3.connect(root / "state.sqlite3", check_same_thread=False)
        self.db.row_factory = sqlite3.Row
        self.lock = threading.Lock()
        with self.db:
            self.db.executescript(SCHEMA)
            self.db.execute("UPDATE jobs SET status='queued', updated_at=? WHERE status IN (?,?)", (time.time(), *TRANSIENT))
            self.db.executescript(SECRETS_SCHEMA)
            existing = self.db.execute("PRAGMA table_info(secrets)").fetchall()
            if not any(col[1] == "working" for col in existing):
                self.db.execute("ALTER TABLE secrets ADD COLUMN working INTEGER")
    def record_secrets(self, job_id, report: Path):
        now = time.time()
        with self.lock, self.db:
            for line in report.read_text(errors="replace").splitlines():
                try: item = json.loads(line)
                except json.JSONDecodeError: continue
                where = (item.get("SourceMetadata", {}).get("Data", {}).get("Filesystem") or {})
                value = item.get("Raw") or item.get("Redacted") or "?"
                file = str(where.get("file") or where.get("path") or "?")
                self.db.execute("INSERT OR IGNORE INTO secrets(job_id,detector,value,file,verified,created_at) VALUES(?,?,?,?,?,?)",
                                (job_id, str(item.get("DetectorName", "?")), value, file, 1 if item.get("Verified") else 0, now))
    def apps(self):
        with self.lock: return list(self.db.execute("SELECT j.id, j.source, j.package, j.version, j.status, count(s.id) secrets FROM jobs j LEFT JOIN secrets s ON s.job_id=j.id GROUP BY j.id ORDER BY j.id"))
    def secrets(self, working=None):
        with self.lock:
            if working is None: return list(self.db.execute("SELECT s.*, j.package FROM secrets s JOIN jobs j ON j.id=s.job_id ORDER BY s.id"))
            return list(self.db.execute("SELECT s.*, j.package FROM secrets s JOIN jobs j ON j.id=s.job_id WHERE s.working=? ORDER BY s.id", (1 if working else 0,)))
    def set_working(self, secret_id, working):
        self.execute("UPDATE secrets SET working=? WHERE id=?", (1 if working else 0, secret_id))

    def close(self): self.db.close()
    def execute(self, sql, values=()):
        with self.lock, self.db:
            return self.db.execute(sql, values)
    def add(self, source, url, package=None, version=None, path=None):
        now = time.time()
        return self.execute("INSERT OR IGNORE INTO jobs(source,release_url,package,version,download_path,status,created_at,updated_at) VALUES(?,?,?,?,?,'queued',?,?)", (source,url,package,version,str(path) if path else None,now,now)).rowcount
    def update(self, job_id, **fields):
        fields["updated_at"] = time.time()
        sets = ", ".join(f"{k}=?" for k in fields)
        self.execute(f"UPDATE jobs SET {sets} WHERE id=?", (*fields.values(), job_id))
    def jobs(self, statuses=("queued",)):
        marks = ",".join("?" * len(statuses))
        with self.lock: return list(self.db.execute(f"SELECT * FROM jobs WHERE status IN ({marks}) ORDER BY id", statuses))
    def counts(self):
        with self.lock: return list(self.db.execute("SELECT status, count(*) n FROM jobs GROUP BY status ORDER BY status"))


class Fetcher:
    def __init__(self, per_host: float): self.per_host, self.last, self.lock = per_host, {}, threading.Lock()
    def get(self, url: str) -> bytes:
        host = urllib.parse.urlsplit(url).netloc
        with self.lock:
            wait = self.per_host - (time.monotonic() - self.last.get(host, 0))
            if wait > 0: time.sleep(wait)
            self.last[host] = time.monotonic()
        request = urllib.request.Request(url, headers={"User-Agent": "apksecrets/1.0 (+local secret scanner)"})
        with urllib.request.urlopen(request, timeout=60) as response: return response.read()

    def download(self, url: str, target: Path):
        data = self.get(url)
        part = target.with_suffix(target.suffix + ".part")
        part.write_bytes(data)
        if not zipfile.is_zipfile(part):
            part.unlink(missing_ok=True); raise Error("download is not a ZIP/APK")
        part.replace(target)


ARCHIVE_SUFFIXES = (".apk", ".apkm", ".apks")


def is_apk_archive(url: str) -> bool:
    return urllib.parse.urlsplit(url).path.lower().endswith(ARCHIVE_SUFFIXES)


def fdroid_names(data: dict) -> dict:
    names = {}
    for app in data.get("apps", []):
        package = app.get("packageName")
        if not package: continue
        localized = app.get("localized", {}).get("en-US", {}) or {}
        name = localized.get("name") or app.get("name")
        if name: names[package] = name.lower()
    return names


def fdroid_releases(data: dict):
    names = fdroid_names(data)
    out = []
    for package, artifacts in data.get("packages", {}).items():
        if not artifacts: continue
        best = max(artifacts, key=lambda a: int(a.get("versionCode", 0)))
        name = best.get("apkName")
        if name and is_apk_archive(name):
            out.append((package, str(best.get("versionName", best.get("versionCode", ""))), urllib.parse.urljoin("https://f-droid.org/repo/", name), names.get(package, "")))
    return out


def aptoide_releases(data: dict):
    out = []
    for app in data.get("datalist", {}).get("list", data.get("data", {}).get("list", [])):
        file = app.get("file") or {}
        url = file.get("path") or file.get("path_alt")
        if url and is_apk_archive(url):
            out.append((app.get("package"), str(app.get("vername", app.get("version", ""))), url))
    return out


def version_key(value: str):
    return tuple((0, int(x)) if x.isdigit() else (1, x) for x in re.findall(r"\d+|\D+", value))


def apk_mirror_apk_links(page: str, base: str):
    """Extract normal artifact links; never follows timers, accounts, or bypass URLs."""
    links = re.findall(r'href=["\']([^"\']+)["\']', html.unescape(page), re.I)
    return [urllib.parse.urljoin(base, x) for x in links if is_apk_archive(x)]


def choose_apk_mirror_link(links):
    links = list(dict.fromkeys(links))
    return min(links, key=lambda x: (0 if "universal" in x.lower() else 1 if "base" in x.lower() else 2 if x.lower().endswith(".apk") else 3, len(x)), default=None)


def safe_unpack(apk: Path, destination: Path, max_bytes: int):
    with zipfile.ZipFile(apk) as archive:
        total = sum(i.file_size for i in archive.infolist())
        if total > max_bytes: raise Error(f"archive expands to {total} bytes (limit {max_bytes})")
        root = destination.resolve()
        for member in archive.infolist():
            target = (destination / member.filename).resolve()
            if not target.is_relative_to(root): raise Error("archive path traversal rejected")
            if member.is_dir(): target.mkdir(parents=True, exist_ok=True); continue
            target.parent.mkdir(parents=True, exist_ok=True)
            with archive.open(member) as src, target.open("wb") as dst: shutil.copyfileobj(src, dst)


def safe_unpack_bundles(root: Path, max_bytes: int):
    """Expand nested split bundles and contained APKs for deep filesystem scanning."""
    for bundle in list(root.rglob("*.apkm")) + list(root.rglob("*.apks")) + list(root.rglob("*.apk")):
        target = bundle.with_suffix(bundle.suffix + ".contents")
        target.mkdir(exist_ok=True)
        safe_unpack(bundle, target, max_bytes)
        bundle.unlink()
        safe_unpack_bundles(target, max_bytes)


def finding_count(report: Path) -> int:
    return sum(1 for line in report.read_text(errors="replace").splitlines() if line.strip() and _json_line(line))

def _json_line(line):
    try: json.loads(line); return True
    except json.JSONDecodeError: return False


def digest(path: Path):
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""): h.update(chunk)
    return h.hexdigest()


def discover(store: Store, fetch: Fetcher, args):
    sources = set(args.source)
    packages = args.package or []
    keywords = [x.lower() for x in (args.keyword or [])]
    allowed = set(packages)
    if "fdroid" in sources:
        log(f"[bold cyan]fdroid[/bold cyan] {I_SEARCH} fetching package index...")
        releases = fdroid_releases(json.loads(fetch.get(FDROID_INDEX)))
        if keywords: releases = [r for r in releases if any(k in r[0].lower() or k in r[3] for k in keywords)]
        if args.random: random.shuffle(releases)
        limit = args.latest_artifact_limit if args.latest_artifact_limit > 0 else (10 if args.random else None)
        new = 0
        for package, version, url, _ in releases[:limit]:
            if not allowed or package in allowed:
                if store.add("fdroid", url, package, version):
                    new += 1
                    log(f"  [green]{I_OK} queued[/green] fdroid {package} [dim]{version}[/dim]")
        if new == 0:
            if releases: log(f"[bold cyan]fdroid[/bold cyan] {I_LIST} no new releases queued (all already processed)")
            else: log(f"[bold cyan]fdroid[/bold cyan] {I_LIST} no releases matched filters")
    for name in ("aptoide", "apkmirror"):
        if name in sources and not (packages or args.keyword):
            log(f"[bold cyan]{name}[/bold cyan] {I_CROSS} skipped - no --package/--keyword given")
    if "aptoide" in sources:
        queries = packages or args.keyword or []
        for package in queries[:args.latest_artifact_limit or None]:
            log(f"[bold cyan]aptoide[/bold cyan] {I_SEARCH} searching '{package}'")
            url = APT_SEARCH + "?" + urllib.parse.urlencode({"query": package, "limit": 10})
            releases = aptoide_releases(json.loads(fetch.get(url)))
            if packages: releases = [r for r in releases if r[0] == package]
            if args.keyword and not packages:
                releases = [r for r in releases if any(k in (r[0] or "").lower() for k in keywords)]
            if releases:
                for package, version, url in releases:
                    if store.add("aptoide", url, package=package, version=version):
                        log(f"  [green]{I_OK} queued[/green] aptoide {package} [dim]{version}[/dim]")
            else:
                log(f"[bold cyan]aptoide[/bold cyan] {I_LIST} no releases found for '{package}'")
    if "apkmirror" in sources:
        queries = packages or args.keyword or []
        for package in queries[:args.latest_artifact_limit or None]:
            log(f"[bold cyan]apkmirror[/bold cyan] {I_SEARCH} searching '{package}'")
            search = APK_MIRROR + "?" + urllib.parse.urlencode({"s": package, "post_type": "app_release"})
            releases = [x for x in apk_mirror_apk_links(fetch.get(search).decode("utf-8", "replace"), search) if "/apk/" in x]
            apps = {}
            for url in releases:
                base = "/".join(urllib.parse.urlsplit(url).path.split("/")[:4])
                apps.setdefault(base, url)
            for base, release_url in list(apps.items())[:args.latest_artifact_limit or 10]:
                files = apk_mirror_apk_links(fetch.get(release_url).decode("utf-8", "replace"), release_url)
                selected = choose_apk_mirror_link(files)
                if selected and store.add("apkmirror", selected, package, ""):
                    log(f"  [green]{I_OK} queued[/green] apkmirror {package}")
            if not apps:
                log(f"[bold cyan]apkmirror[/bold cyan] {I_LIST} no releases found for '{package}'")


def process(store: Store, fetch: Fetcher, job: sqlite3.Row, args, progress=None, task_id=None):
    job_id = job["id"]
    name = job["package"] or job["release_url"]
    def stage(desc: str) -> None:
        if progress is not None and task_id is not None:
            progress.update(task_id, description=f"[bold cyan]{name}[/bold cyan] {desc}")
            progress.advance(task_id)
    try:
        path = Path(job["download_path"]) if job["download_path"] else None
        if not path or not path.is_file() or not zipfile.is_zipfile(path):
            store.update(job_id, status="downloading", error=None)
            path = store.root / "apks" / f"{job_id}.apk"
            stage(f"{I_DOWN} downloading")
            fetch.download(job["release_url"], path)
            stage(f"{I_BOX} {path.stat().st_size / 1e6:.1f} MB")
        else:
            stage(f"{I_SYNC} cached")
        sha = digest(path)
        store.update(job_id, status="downloaded", download_path=str(path), sha256=sha)
        store.update(job_id, status="scanning")
        report = store.root / "reports" / f"{job_id}.jsonl"
        stderr = store.root / "reports" / f"{job_id}.stderr"
        with tempfile.TemporaryDirectory(prefix="apksecrets-", dir=store.root) as temp:
            stage(f"{I_SEARCH} scanning")
            safe_unpack(path, Path(temp), args.max_unpacked_bytes)
            safe_unpack_bundles(Path(temp), args.max_unpacked_bytes)
            run = subprocess.run([args.trufflehog, "filesystem", ".", "--json", "--no-update"], capture_output=True, text=True, timeout=args.scan_timeout, cwd=temp)
            report.write_text(run.stdout); stderr.write_text(run.stderr)
            os.chmod(report, 0o600); os.chmod(stderr, 0o600)
            if run.returncode not in (0, 183):
                log(f"#{job_id} [red]{I_CROSS} trufflehog stderr:[/red] {run.stderr[:500]}")
                raise Error(f"trufflehog exited {run.returncode}")
        found = finding_count(report)
        # Report is durable before state commit/deletion.
        if found:
            store.update(job_id, status="findings", report_path=str(report), error=None)
            stage(f"[bold red]{I_SKULL} {found} secrets[/bold red]")
            store.record_secrets(job_id, report)
            ids = [row["id"] for row in store.db.execute("SELECT id FROM secrets WHERE job_id=? ORDER BY id", (job_id,))]
            idx = 0
            seen = set()
            for line in report.read_text(errors="replace").splitlines():
                try: item = json.loads(line)
                except json.JSONDecodeError: continue
                where = (item.get("SourceMetadata", {}).get("Data", {}).get("Filesystem") or {})
                value = item.get("Raw") or item.get("Redacted") or "?"
                file = str(where.get("file") or where.get("path") or "?")
                key = (item.get("DetectorName"), value, file)
                if key in seen: continue
                seen.add(key)
                log(f"\\[*] [dim]#{ids[idx]}[/dim] Secret [bold yellow]{escape(str(item.get('DetectorName', '?')))}[/bold yellow] [bold red]{escape(str(value))}[/bold red] in [bold cyan]{escape(name)}[/bold cyan] {escape(file)}")
                idx += 1
        else:
            try:
                path.unlink(); store.update(job_id, status="clean", report_path=str(report), error=None, download_path=None)
                stage(f"[green]{I_OK} clean[/green]")
            except OSError as e:
                store.update(job_id, status="cleanup_failed", report_path=str(report), error=str(e))
                log(f"#{job_id} [yellow]{I_WARN} cleanup failed[/yellow] {e}")
    except Exception as e:
        retries = job["retries"] + 1
        status = "queued" if retries <= args.retries else "failed"
        if progress is not None and task_id is not None:
            progress.update(task_id, description=f"[bold yellow]{I_SYNC} {name} retry {retries}/{args.retries}[/bold yellow]")
        log(f"#{job_id} [bold yellow]{I_SYNC} {status}[/bold yellow] (retry {retries}/{args.retries}) {str(e)[:200]}")
        store.update(job_id, status=status, retries=retries, error=str(e)[:500])
        if status == "queued":
            return process(store, fetch, {**dict(job), "retries": retries}, args, progress, task_id)


def import_files(store: Store, source: Path):
    files = [source] if source.is_file() else (p for suffix in ARCHIVE_SUFFIXES for p in source.glob(f"*{suffix}"))
    for file in files:
        if file.is_file() and file.suffix.lower() in ARCHIVE_SUFFIXES and zipfile.is_zipfile(file):
            sha = digest(file); target = store.root / "apks" / f"local-{sha}.apk"
            if not target.exists():
                part = target.with_suffix(".apk.part")
                shutil.copy2(file, part)
                if not zipfile.is_zipfile(part): part.unlink(missing_ok=True); continue
                part.replace(target)
            if store.add("local", f"local://{sha}", path=target): log(f"  [green]✓ queued[/green] local {file.name}")


def scan_loop(store: Store, fetch: Fetcher, args, stop_event=None):
    cycle = 0
    while True:
        if stop_event is not None and stop_event.is_set(): break
        cycle += 1
        console.rule(f"[bold cyan]{I_SYNC} cycle {cycle}[/bold cyan] [dim]{', '.join(args.source)}[/dim]")
        with console.status(f"[bold cyan]{I_SEARCH} discovering releases…[/bold cyan]"):
            discover(store, fetch, args)
        jobs = store.jobs()
        log(f"[bold]{I_LIST} {len(jobs)} job(s) queued for processing[/bold]")
        if not jobs and args.forever:
            reusable = [job for job in store.jobs(("clean", "failed", "findings"))
                        if job["download_path"] and Path(job["download_path"]).is_file()]
            if reusable:
                to_requeue = random.sample(reusable, min(len(reusable), 10))
                for job in to_requeue:
                    store.update(job["id"], status="queued", retries=0, error=None)
                log(f"[bold yellow]{I_SYNC} re-queued {len(to_requeue)} cached jobs for continuous scanning (no re-downloads)[/bold yellow]")
                jobs = store.jobs()
        with Progress(SpinnerColumn(style="bold green"), TextColumn("[bold]{task.description}[/bold]"), BarColumn(bar_width=None), TextColumn("[dim]{task.percentage:>3.0f}%[/dim]"), TimeElapsedColumn(), console=console) as progress:
            tasks = {job["id"]: progress.add_task(f"[cyan]{job['package'] or job['release_url']}[/cyan] {I_CLOCK} queued", total=3) for job in jobs}
            with ThreadPoolExecutor(max_workers=max(1, args.workers)) as pool:
                futures = [pool.submit(process, store, fetch, job, args, progress, tasks[job["id"]]) for job in jobs]
                done = 0
                for future in as_completed(futures):
                    future.result(); done += 1
                    if stop_event is not None and stop_event.is_set():
                        for f in futures: f.cancel()
                        log(f"[yellow]{I_SYNC} scan stopped, {len(jobs) - done} pending job(s) left queued[/yellow]")
                        break
        status_icons = {"clean": I_OK, "findings": I_SKULL, "failed": I_CROSS, "queued": I_LIST, "downloading": I_DOWN, "scanning": I_SEARCH}
        summary = ", ".join(f"{status_icons.get(row['status'], '•')} {row['status']}: {row['n']}" for row in store.counts())
        log(f"[bold]{I_OK} cycle {cycle} done[/bold] {summary}")
        console.rule(f"[bold]{I_OK} cycle {cycle} complete[/bold]")
        if not args.forever: break
        remaining = args.interval
        while remaining > 0:
            log(f"[dim]{I_CLOCK} next cycle in {remaining:g}s (Ctrl-C to stop)[/dim]")
            pause = min(max(1.0, args.interval / 6), remaining)
            if stop_event is not None:
                if stop_event.wait(pause): break
            else:
                time.sleep(pause)
            remaining -= pause


WEB_DIR = Path(__file__).resolve().parent


class WebUi:
    def __init__(self):
        self.lock = threading.Lock()
        self.running = False
        self.stopping = False
        self.stop_event = None
        self.config = None


def serve(args):
    store = Store(args.state)
    ui = WebUi()

    def worker(config):
        ns = types.SimpleNamespace(
            source=config["sources"], package=[], keyword=config["keywords"],
            random=config["random"], forever=config["forever"], interval=config["interval"],
            workers=config["workers"], rate=1.0, latest_artifact_limit=config["limit"],
            retries=2, max_unpacked_bytes=1_000_000_000, scan_timeout=1800,
            trufflehog=args.trufflehog)
        try:
            scan_loop(store, Fetcher(ns.rate), ns, ui.stop_event)
        except Exception as e:
            log(f"[red]{I_CROSS} scan crashed: {escape(str(e)[:300])}[/red]")
        finally:
            with ui.lock:
                ui.running = False; ui.stopping = False
            log("[bold]scan stopped[/bold]")

    class Handler(http.server.BaseHTTPRequestHandler):
        def send_bytes(self, body, ctype, code=200):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        def send_json(self, obj, code=200):
            self.send_bytes(json.dumps(obj).encode(), "application/json", code)
        def read_json(self):
            try:
                length = int(self.headers.get("Content-Length") or 0)
                return json.loads(self.rfile.read(length) or b"{}")
            except (ValueError, json.JSONDecodeError):
                return None
        def do_GET(self):
            url = urllib.parse.urlsplit(self.path)
            if url.path in ("/", "/index.html"):
                try: self.send_bytes((WEB_DIR / "webui.html").read_bytes(), "text/html; charset=utf-8")
                except OSError: self.send_json({"error": "webui.html missing"}, 500)
            elif url.path == "/api/state":
                with _log_lock: seq = _log_seq
                counts = {row["status"]: row["n"] for row in store.counts()}
                with ui.lock:
                    self.send_json({"running": ui.running, "stopping": ui.stopping, "config": ui.config, "counts": counts, "log_seq": seq})
            elif url.path == "/api/logs":
                after = int(dict(urllib.parse.parse_qsl(url.query)).get("after", 0) or 0)
                with _log_lock: logs = [e for e in _log_buffer if e["seq"] > after]
                self.send_json({"logs": logs})
            elif url.path == "/api/apps":
                self.send_json({"apps": [dict(r) for r in store.apps()]})
            elif url.path == "/api/secrets":
                self.send_json({"secrets": [dict(r) for r in store.secrets()]})
            else: self.send_json({"error": "not found"}, 404)
        def do_POST(self):
            url = urllib.parse.urlsplit(self.path)
            if url.path == "/api/scan/start":
                body = self.read_json()
                if body is None: self.send_json({"error": "bad request"}, 400); return
                try:
                    config = {
                        "sources": [s for s in body.get("sources", ["fdroid"]) if s in ("fdroid", "aptoide", "apkmirror", "local")] or ["fdroid"],
                        "keywords": [k.strip() for k in str(body.get("keywords", "")).split(",") if k.strip()],
                        "random": bool(body.get("random", False)),
                        "forever": bool(body.get("forever", False)),
                        "interval": max(0.0, float(body.get("interval", 30))),
                        "workers": max(1, int(body.get("workers", DEFAULT_WORKERS))),
                        "limit": max(0, int(body.get("limit", 0))),
                    }
                except (TypeError, ValueError): self.send_json({"error": "bad request"}, 400); return
                with ui.lock:
                    if ui.running: self.send_json({"error": "scan already running"}, 409); return
                    ui.config, ui.running, ui.stopping = config, True, False
                    ui.stop_event = threading.Event()
                    threading.Thread(target=worker, args=(config,), daemon=True).start()
                log(f"[bold]scan started[/bold] sources: {', '.join(config['sources'])}")
                self.send_json({"ok": True})
            elif url.path == "/api/scan/stop":
                with ui.lock:
                    if not ui.running: self.send_json({"error": "no scan running"}, 409); return
                    ui.stopping = True
                    ui.stop_event.set()
                log("[yellow]stopping after current jobs...[/yellow]")
                self.send_json({"ok": True})
            elif url.path == "/api/mark":
                body = self.read_json() or {}
                try: store.set_working(int(body.get("id", 0)), body.get("verdict") == "working")
                except (TypeError, ValueError): self.send_json({"error": "bad request"}, 400); return
                self.send_json({"ok": True})
            elif url.path == "/api/retry-failed":
                store.execute("UPDATE jobs SET status='queued', retries=0, error=NULL, updated_at=? WHERE status='failed'", (time.time(),))
                log(f"[bold yellow]{I_SYNC} failed jobs re-queued[/bold yellow]")
                self.send_json({"ok": True})
            elif url.path == "/api/import":
                body = self.read_json() or {}
                path = Path(str(body.get("path", "")))
                if not path.exists(): self.send_json({"error": "path not found"}, 400); return
                import_files(store, path)
                self.send_json({"ok": True})
            else: self.send_json({"error": "not found"}, 404)
        def log_message(self, *a): pass

    server = http.server.ThreadingHTTPServer((args.host, args.port), Handler)
    console.print(Panel.fit(f"[bold cyan]APK Secret Scanner[/bold cyan]\n[dim]web ui on http://{args.host}:{args.port}[/dim]", border_style="cyan"))
    try: server.serve_forever()
    except KeyboardInterrupt: pass
    finally:
        if ui.stop_event: ui.stop_event.set()
        server.server_close(); store.close()


def parser():
    root_common = argparse.ArgumentParser(add_help=False)
    root_common.add_argument("--state", type=Path, default=Path(".apksecrets"))
    root_common.add_argument("--trufflehog", default="trufflehog")
    sub_common = argparse.ArgumentParser(add_help=False)
    sub_common.add_argument("--state", type=Path, default=argparse.SUPPRESS)
    sub_common.add_argument("--trufflehog", default=argparse.SUPPRESS)
    p = argparse.ArgumentParser(prog="apksecrets", parents=[root_common]); sub = p.add_subparsers(dest="command", required=True)
    run = sub.add_parser("run", aliases=["scrape", "full"], parents=[sub_common]); run.add_argument("--source", action="append", choices=("fdroid","aptoide","apkmirror","local"), default=[])
    run.add_argument("--import", dest="imports", action="append", type=Path, help="queue a local .apk/.apkm/.apks folder or file")
    run.add_argument("--package", action="append", help="exact package id (repeatable)"); run.add_argument("--keyword", action="append", help="package/name substring (repeatable)")
    run.add_argument("--random", action="store_true", help="shuffle matching F-Droid artifacts")
    run.add_argument("--forever", action="store_true", help="repeat discovery and scanning until interrupted")
    run.add_argument("--interval", type=float, default=30.0, help="seconds between forever cycles")
    run.add_argument("--workers", type=int, default=DEFAULT_WORKERS); run.add_argument("--rate", type=float, default=1.0)
    run.add_argument("--latest-artifact-limit", type=int, default=0, help="cap discovered latest releases (0 means no cap)")
    run.add_argument("--retries", type=int, default=2); run.add_argument("--max-unpacked-bytes", type=int, default=1_000_000_000); run.add_argument("--scan-timeout", type=int, default=1800)
    imp = sub.add_parser("import", parents=[sub_common]); imp.add_argument("path", type=Path)
    sub.add_parser("status", parents=[sub_common]); sub.add_parser("failures", parents=[sub_common]); sub.add_parser("retry-failed", parents=[sub_common])
    apps = sub.add_parser("apps", parents=[sub_common])
    secrets_cmd = sub.add_parser("secrets", parents=[sub_common]); secrets_cmd.add_argument("--working", type=int, choices=(0, 1), default=None)
    mark = sub.add_parser("mark", parents=[sub_common]); mark.add_argument("secret_id", type=int); mark.add_argument("verdict", choices=("working", "broken"))
    web = sub.add_parser("serve", parents=[sub_common]); web.add_argument("--host", default="127.0.0.1"); web.add_argument("--port", type=int, default=8000)
    return p


def main(argv=None):
    args = parser().parse_args(argv); store = Store(args.state)
    try:
        if args.command == "serve": serve(args); return 0
        if args.command == "import": import_files(store, args.path); return 0
        if args.command == "retry-failed": store.execute("UPDATE jobs SET status='queued', retries=0, error=NULL, updated_at=? WHERE status='failed'", (time.time(),)); return 0
        if args.command == "apps":
            rows = store.db.execute("SELECT j.id, j.source, j.package, j.version, j.status, count(s.id) secrets FROM jobs j LEFT JOIN secrets s ON s.job_id=j.id GROUP BY j.id ORDER BY j.id").fetchall()
            table = Table(title=f"{I_BOX} Apps")
            for column in ("id", "source", "package", "version", "status", "secrets"): table.add_column(column)
            for row in rows:
                table.add_row(str(row["id"]), row["source"], row["package"] or "-", row["version"] or "-", row["status"], str(row["secrets"]))
            console.print(table); return 0
        if args.command == "secrets":
            rows = store.secrets(None if args.working is None else bool(args.working))
            table = Table(title=f"{I_KEY} Secrets")
            for column in ("id", "detector", "value", "app", "file", "verified", "working"): table.add_column(column)
            for row in rows:
                working = {None: "-", 1: f"[green]{I_OK} working[/green]", 0: f"[red]{I_CROSS} broken[/red]"}[row["working"]]
                table.add_row(str(row["id"]), row["detector"], row["value"], row["package"] or "-", row["file"], "yes" if row["verified"] else "no", working)
            console.print(table); return 0
        if args.command == "mark":
            store.set_working(args.secret_id, args.verdict == "working")
            log(f"{I_OK} secret #{args.secret_id} marked [bold]{args.verdict}[/bold]")
            return 0
        if args.command in ("status", "failures"):
            rows = store.counts() if args.command == "status" else store.jobs(("failed", "cleanup_failed"))
            table = Table(title="APK Secret Scanner")
            columns = ("status", "count") if args.command == "status" else ("id", "source", "package", "status", "retries", "error")
            for column in columns: table.add_column(column)
            for row in rows:
                values = [str(row["n"] if column == "count" else row[column] or "") for column in columns]
                table.add_row(*values)
            console.print(table)
            return 0
        if args.workers < 1 or args.rate <= 0 or args.interval < 0 or args.retries < 0 or args.max_unpacked_bytes < 1 or args.latest_artifact_limit < 0:
            raise Error("workers, rate, retries, and limits must be positive (retries/limit may be zero)")
        for path in args.imports or []: import_files(store, path)
        if not args.source: args.source = ["fdroid", "aptoide", "apkmirror"]
        fetch = Fetcher(args.rate)
        console.print(Panel.fit("[bold cyan]APK Secret Scanner[/bold cyan]\n[dim]discover → download → unpack → scan → retain[/dim]", border_style="cyan"))
        scan_loop(store, fetch, args)
        return 0
    finally: store.close()


if __name__ == "__main__": raise SystemExit(main())
