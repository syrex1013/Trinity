class Error(RuntimeError): pass


class Store:
    def __init__(self, root: Path):
        self.root = root
        root.mkdir(parents=True, exist_ok=True)
        os.chmod(root, 0o700)
        for name in ("apks", "reports"):
            (root / name).mkdir(exist_ok=True)
        self.db = sqlite3.connect(root / "state.sqlite3", check_same_thread=False)
        self.db.row_factory = sqlite3.Row
        self.lock = threading.Lock()
        with self.db:
            self.db.executescript(SCHEMA)
            self.db.execute("UPDATE jobs SET status='queued', updated_at=? WHERE status IN (?,?)", (time.time(), *TRANSIENT))
            self.db.executescript(SECRETS_SCHEMA)
            existing = self.db.execute("PRAGMA table_info(secrets)").fetchall()
            if not any(col[1] == "working" for col in existing):
                self.db.execute("ALTER TABLE secrets ADD COLUMN working INTEGER")
    def record_secrets(self, job_id, report: Path):
        now = time.time()
        with self.lock, self.db:
            for line in report.read_text(errors="replace").splitlines():
                try: item = json.loads(line)
                except json.JSONDecodeError: continue
                where = (item.get("SourceMetadata", {}).get("Data", {}).get("Filesystem") or {})
                value = str(item.get("Raw") or item.get("Redacted") or "?")
                file = str(where.get("file") or where.get("path") or "?")
                self.db.execute("INSERT OR IGNORE INTO secrets(job_id,detector,value,file,verified,working,created_at) VALUES(?,?,?,?,?,?,?)",
                                (job_id, str(item.get("DetectorName", "?")), value, file, 1 if item.get("Verified") else 0, 1 if item.get("Verified") else None, now))
    def apps(self):
        with self.lock: return list(self.db.execute("SELECT j.id, j.source, j.package, j.version, j.status, count(s.id) secrets FROM jobs j LEFT JOIN secrets s ON s.job_id=j.id GROUP BY j.id ORDER BY j.id"))
    def known_urls(self):
        with self.lock: return {row[0] for row in self.db.execute("SELECT release_url FROM jobs")}
    def secrets(self, working=None):
        with self.lock:
            if working is None: return list(self.db.execute("SELECT s.*, j.package FROM secrets s JOIN jobs j ON j.id=s.job_id ORDER BY s.id"))
            return list(self.db.execute("SELECT s.*, j.package FROM secrets s JOIN jobs j ON j.id=s.job_id WHERE s.working=? ORDER BY s.id", (1 if working else 0,)))
    def set_working(self, secret_id, working):
        self.execute("UPDATE secrets SET working=? WHERE id=?", (1 if working else 0, secret_id))

    def close(self): self.db.close()
    def execute(self, sql, values=()):
        with self.lock, self.db:
            return self.db.execute(sql, values)
    def add(self, source, url, package=None, version=None, path=None):
        now = time.time()
        with self.lock, self.db:
            cur = self.db.execute("INSERT OR IGNORE INTO jobs(source,release_url,package,version,download_path,status,created_at,updated_at) VALUES(?,?,?,?,?,'queued',?,?)", (source,url,package,version,str(path) if path else None,now,now))
            if not cur.rowcount: return None
            return self.db.execute("SELECT * FROM jobs WHERE release_url=?", (url,)).fetchone()
    def update(self, job_id, **fields):
        fields["updated_at"] = time.time()
        sets = ", ".join(f"{k}=?" for k in fields)
        self.execute(f"UPDATE jobs SET {sets} WHERE id=?", (*fields.values(), job_id))
    def jobs(self, statuses=("queued",)):
        marks = ",".join("?" * len(statuses))
        with self.lock: return list(self.db.execute(f"SELECT * FROM jobs WHERE status IN ({marks}) ORDER BY id", statuses))
    def counts(self):
        with self.lock: return list(self.db.execute("SELECT status, count(*) n FROM jobs GROUP BY status ORDER BY status"))


class Fetcher:
    """Per-host rate-limited HTTP client. Payloads over a megabyte (the 60 MB
    f-droid index) are kept and revalidated with If-None-Match, so forever-mode
    cycles get a 304 instead of re-downloading them."""
    REVALIDATE_MIN, REVALIDATE_MAX = 1 << 20, 4

    def __init__(self, per_host: float):
        self.per_host, self.last, self.lock = per_host, {}, threading.Lock()
        self.reuse = {}

    def _gate(self, url: str) -> None:
        host = urllib.parse.urlsplit(url).netloc
        with self.lock:
            wait = self.per_host - (time.monotonic() - self.last.get(host, 0))
            if wait > 0: time.sleep(wait)
            self.last[host] = time.monotonic()

    def get(self, url: str) -> bytes:
        self._gate(url)
        entry = self.reuse.get(url)
        headers = {"User-Agent": UA, "Accept-Encoding": "gzip"}
        if entry: headers["If-None-Match"] = entry[0]
        request = urllib.request.Request(url, headers=headers)
        try:
            with urllib.request.urlopen(request, timeout=60) as response:
                size = int(response.headers.get("Content-Length") or 0)
                host = urllib.parse.urlsplit(url).netloc
                chunks, total, last_note = [], 0, time.monotonic()
                while True:
                    chunk = response.read(1 << 20)
                    if not chunk: break
                    chunks.append(chunk); total += len(chunk)
                    if total >= self.REVALIDATE_MIN and time.monotonic() - last_note >= 10:
                        log(f"[dim]{I_DOWN} {host}: {total / 1e6:.0f} MB{' / ' + f'{size / 1e6:.0f} MB' if size else ''} fetched (slow mirrors throttle)[/dim]")
                        last_note = time.monotonic()
                data = b"".join(chunks)
                if response.headers.get("Content-Encoding", "").lower() in ("gzip", "x-gzip"): data = gzip.decompress(data)
                if len(data) >= self.REVALIDATE_MIN and response.headers.get("ETag"):
                    if len(self.reuse) >= self.REVALIDATE_MAX: self.reuse.pop(next(iter(self.reuse)))
                    self.reuse[url] = (response.headers["ETag"], data)
                return data
        except urllib.error.HTTPError as error:
            if error.code != 304 or not entry: raise
            error.close()
            return entry[1]

    def download(self, url: str, target: Path):
        """Stream straight to disk — buffering the whole response makes busy
        mirrors (f-droid in particular) throttle the connection for minutes."""
        self._gate(url)
        part = target.with_suffix(target.suffix + ".part")
        request = urllib.request.Request(url, headers={"User-Agent": UA})
        with urllib.request.urlopen(request, timeout=60) as response:
            with part.open("wb") as dst:
                shutil.copyfileobj(response, dst)
        if not zipfile.is_zipfile(part):
            part.unlink(missing_ok=True); raise Error("download is not a ZIP/APK")
        part.replace(target)


ARCHIVE_SUFFIXES = (".apk", ".apkm", ".apks", ".xapk")


def is_apk_archive(url: str) -> bool:
    return urllib.parse.urlsplit(url).path.lower().endswith(ARCHIVE_SUFFIXES)


def fdroid_names(data: dict) -> dict:
    names = {}
    for app in data.get("apps", []):
        package = app.get("packageName")
        if not package: continue
        localized = app.get("localized", {}).get("en-US", {}) or {}
        name = localized.get("name") or app.get("name")
        if name: names[package] = name.lower()
    return names


def fdroid_releases(data: dict):
    names = fdroid_names(data)
    out = []
    for package, artifacts in data.get("packages", {}).items():
        if not artifacts: continue
        best = max(artifacts, key=lambda a: int(a.get("versionCode", 0)))
        name = best.get("apkName")
        if name and is_apk_archive(name):
            out.append((package, str(best.get("versionName", best.get("versionCode", ""))), urllib.parse.urljoin("https://f-droid.org/repo/", name), names.get(package, "")))
    return out


def aptoide_releases(data: dict):
    out = []
    for app in data.get("datalist", {}).get("list", data.get("data", {}).get("list", [])):
        file = app.get("file") or {}
        url = file.get("path") or file.get("path_alt")
        if url and is_apk_archive(url):
            name = app.get("name") or (app.get("localized", {}).get("en-US", {}) or {}).get("name") or ""
            out.append((app.get("package"), str(file.get("vername") or app.get("vername") or app.get("version") or ""), url, name.lower()))
    return out


def version_key(value: str):
    return tuple((0, int(x)) if x.isdigit() else (1, x) for x in re.findall(r"\d+|\D+", value))


def apkcombo_apps(page: str, base: str):
    """App detail links as (package, url) from a search page; path-traversal safe, deduped."""
    seen = {}
    for link in re.findall(r'href=["\']([^"\']+)["\']', html.unescape(page), re.I):
        path = urllib.parse.urlsplit(urllib.parse.urljoin(base, link)).path
        m = re.fullmatch(r"(/[a-z0-9][a-z0-9-]*/([a-zA-Z0-9_]+\.[a-zA-Z0-9_.]+))/?", path)
        if m and m.group(2) not in seen:
            seen[m.group(2)] = urllib.parse.urljoin(base, m.group(1) + "/")
    return list(seen.items())


def apkcombo_release(fetch: Fetcher, app_url: str):
    """Latest (artifact_url, version) for one app page, or None; follows normal links only."""
    page = fetch.get(app_url + "download/").decode("utf-8", "replace")
    version = (re.findall(r"/download/[a-z]+-([\w.]+)-apk", page) or [""])[0]
    variant = fetch.get(app_url + "download/apk").decode("utf-8", "replace")
    url, name = None, ""
    m = re.search(r'href="(/r2\?u=[^"]+)"', variant)
    if m:
        url = urllib.parse.parse_qs(urllib.parse.urlsplit(APKCOMBO + m.group(1)).query).get("u", [None])[0]
    else:
        # most apps wrap the artifact in a base64 /d?u= link on the variant page itself
        m = re.search(r'href="(?:https://apkcombo\.com)?/d\?u=([^"&]+)', variant)
        if m:
            try: url = base64.b64decode(m.group(1) + "==" * (-len(m.group(1)) % 4)).decode("utf-8", "replace")
            except Exception: url = None
    if not url: return None
    # pureapk URLs hide the extension; the decoded URL's _fn param names the file
    fn = re.search(r"_fn=([A-Za-z0-9+/=%]+)", url)
    while fn:
        try: name = urllib.parse.unquote(base64.b64decode(fn.group(1) + "==" * (-len(fn.group(1)) % 4)).decode("utf-8", "replace"))
        except Exception: break
        fn = re.search(r"_fn=([A-Za-z0-9+/=%]+)", name)
    name = name.replace("+", " ")
    if not is_apk_archive(url) and not is_apk_archive(name): return None
    if not version and name:
        m = re.search(r"_(\d[\w.]*)_apkcombo", name)
        version = m.group(1) if m else ""
    if not version:
        parts = urllib.parse.urlsplit(url).path.split("/")
        version = parts[-2] if len(parts) > 2 and not is_apk_archive(parts[-2]) else ""
    return url, version


def safe_unpack(apk: Path, destination: Path, max_bytes: int):
    with zipfile.ZipFile(apk) as archive:
        total = sum(i.file_size for i in archive.infolist())
        if total > max_bytes: raise Error(f"archive expands to {total} bytes (limit {max_bytes})")
        root = destination.resolve()
        for member in archive.infolist():
            target = (destination / member.filename).resolve()
            if not target.is_relative_to(root): raise Error("archive path traversal rejected")
            if member.is_dir(): target.mkdir(parents=True, exist_ok=True); continue
            target.parent.mkdir(parents=True, exist_ok=True)
            with archive.open(member) as src, target.open("wb") as dst: shutil.copyfileobj(src, dst)


def safe_unpack_bundles(root: Path, max_bytes: int):
    """Expand nested split bundles and contained APKs for deep filesystem scanning."""
    for bundle in list(root.rglob("*.apkm")) + list(root.rglob("*.apks")) + list(root.rglob("*.apk")):
        target = bundle.with_suffix(bundle.suffix + ".contents")
        target.mkdir(exist_ok=True)
        safe_unpack(bundle, target, max_bytes)
        bundle.unlink()
        safe_unpack_bundles(target, max_bytes)


def finding_count(report: Path) -> int:
    return sum(1 for line in report.read_text(errors="replace").splitlines() if line.strip() and _json_line(line))

def _json_line(line):
    try: json.loads(line); return True
    except json.JSONDecodeError: return False


def digest(path: Path):
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""): h.update(chunk)
    return h.hexdigest()


def _discover_fdroid(store, fetch, args, packages, keywords, allowed):
    data = json.loads(fetch.get(FDROID_INDEX))
    releases = fdroid_releases(data)
    if keywords: releases = [r for r in releases if any(k in r[0].lower() or k in r[3] for k in keywords)]
    if allowed: releases = [r for r in releases if r[0] in allowed]
    fresh = [r for r in releases if r[2] not in store.known_urls()]
    if args.random: random.shuffle(fresh)
    limit = args.latest_artifact_limit if args.latest_artifact_limit > 0 else (10 if args.random else None)
    for package, version, url, _ in fresh[:limit]:
        job = store.add("fdroid", url, package, version)
        if job is not None: yield job
    if not fresh:
        if releases: log(f"[bold cyan]fdroid[/bold cyan] {I_LIST} no new releases ({len(releases)} matching)")
        else: log(f"[bold cyan]fdroid[/bold cyan] {I_LIST} no releases matched filters")


def _discover_aptoide(store, fetch, args, packages, keywords, allowed):
    limit = args.latest_artifact_limit
    page = min(limit, 50) if limit else 10
    queued = 0
    for query in packages or args.keyword or []:
        if limit and queued >= limit: break
        found, offset, seen = 0, 0, set()
        while True:
            params = {"query": query, "limit": page}
            if offset: params["offset"] = offset
            data = json.loads(fetch.get(APT_SEARCH + "?" + urllib.parse.urlencode(params)))
            releases = [r for r in aptoide_releases(data) if r[0] and r[0] not in seen]
            seen.update(r[0] for r in releases)
            if allowed: releases = [r for r in releases if r[0] in allowed]
            if args.keyword and not packages:
                releases = [r for r in releases if any(k in (r[0] or "").lower() or k in r[3] for k in keywords)]
            if limit: releases = releases[:limit - queued]
            for package, version, url, _ in releases:
                job = store.add("aptoide", url, package, version)
                if job is not None: yield job
            found += len(releases)
            queued += len(releases)
            offset = data.get("datalist", {}).get("next")
            if not offset or not limit or queued >= limit: break
        if not found: log(f"[bold cyan]aptoide[/bold cyan] {I_LIST} no releases found for '{escape(query)}'")


def _discover_apkcombo(store, fetch, args, packages, keywords, allowed):
    limit = args.latest_artifact_limit
    queued = 0
    for query in packages or args.keyword or []:
        if limit and queued >= limit: break
        apps = apkcombo_apps(fetch.get(APKCOMBO + "/search/" + urllib.parse.quote(query)).decode("utf-8", "replace"), APKCOMBO)
        if allowed: apps = [a for a in apps if a[0] in allowed]
        if args.keyword and not packages:
            apps = [a for a in apps if any(k in (a[0] or "").lower() for k in keywords)]
        found = 0
        cap = limit - queued if limit else 10
        for package, app_url in apps[:cap]:
            release = apkcombo_release(fetch, app_url)
            if not release: continue
            found += 1
            queued += 1
            url, version = release
            job = store.add("apkcombo", url, package, version)
            if job is not None: yield job
        if not found: log(f"[bold cyan]apkcombo[/bold cyan] {I_LIST} no releases found for '{escape(query)}'")


def discover(store: Store, fetch: Fetcher, args):
    """Queue and yield new job rows as each source discovers them.

    One failing source (network error, block page) is logged and skipped;
    each release is queued the moment it is found, not after all sources
    finish.
    """
    packages = args.package or []
    keywords = [x.lower() for x in (args.keyword or [])]
    allowed = set(packages)
    for name in ("aptoide", "apkcombo"):
        if name in args.source and not (packages or args.keyword):
            log(f"[bold cyan]{name}[/bold cyan] {I_CROSS} skipped - no --package/--keyword given")
    for name, worker in (("fdroid", _discover_fdroid), ("aptoide", _discover_aptoide), ("apkcombo", _discover_apkcombo)):
        if name not in args.source: continue
        log(f"[bold cyan]{name}[/bold cyan] {I_SEARCH} discovering releases...")
        try:
            yield from worker(store, fetch, args, packages, keywords, allowed)
        except Exception as e:
            log(f"[bold cyan]{name}[/bold cyan] [red]{I_CROSS} discovery failed[/red] {escape(str(e)[:200])}", kind="error")


def process(store: Store, fetch: Fetcher, job: sqlite3.Row, args, progress=None, task_id=None):
    job_id = job["id"]
    name = job["package"] or job["release_url"]
    def stage(desc: str) -> None:
        if progress is not None and task_id is not None:
            progress.update(task_id, description=f"[bold cyan]{name}[/bold cyan] {desc}")
            progress.advance(task_id)
    try:
        path = Path(job["download_path"]) if job["download_path"] else None
        if not path or not path.is_file() or not zipfile.is_zipfile(path):
            store.update(job_id, status="downloading", error=None)
            path = store.root / "apks" / f"{job_id}.apk"
            stage(f"{I_DOWN} downloading")
            log(f"#{job_id} {I_DOWN} downloading [cyan]{escape(name)}[/cyan]")
            fetch.download(job["release_url"], path)
            stage(f"{I_BOX} {path.stat().st_size / 1e6:.1f} MB")
        else:
            stage(f"{I_SYNC} cached")
        sha = digest(path)
        store.update(job_id, status="downloaded", download_path=str(path), sha256=sha)
        store.update(job_id, status="scanning")
        report = store.root / "reports" / f"{job_id}.jsonl"
        stderr = store.root / "reports" / f"{job_id}.stderr"
        with tempfile.TemporaryDirectory(prefix="apksecrets-", dir=store.root) as temp:
            stage(f"{I_SEARCH} scanning")
            log(f"#{job_id} {I_SEARCH} scanning [cyan]{escape(name)}[/cyan]")
            safe_unpack(path, Path(temp), args.max_unpacked_bytes)
            safe_unpack_bundles(Path(temp), args.max_unpacked_bytes)
            run = subprocess.run([args.trufflehog, "filesystem", ".", "--json", "--no-update"], capture_output=True, text=True, timeout=args.scan_timeout, cwd=temp)
            report.write_text(run.stdout); stderr.write_text(run.stderr)
            os.chmod(report, 0o600); os.chmod(stderr, 0o600)
            if run.returncode not in (0, 183):
                log(f"#{job_id} [red]{I_CROSS} trufflehog stderr:[/red] {run.stderr[:500]}", kind="error")
                raise Error(f"trufflehog exited {run.returncode}")
        found = finding_count(report)
        # Report is durable before state commit/deletion.
        if found:
            store.update(job_id, status="findings", report_path=str(report), error=None)
            stage(f"[bold red]{I_SKULL} {found} secrets[/bold red]")
            store.record_secrets(job_id, report)
            ids = [row["id"] for row in store.db.execute("SELECT id FROM secrets WHERE job_id=? ORDER BY id", (job_id,))]
            idx = 0
            seen = set()
            for line in report.read_text(errors="replace").splitlines():
                try: item = json.loads(line)
                except json.JSONDecodeError: continue
                where = (item.get("SourceMetadata", {}).get("Data", {}).get("Filesystem") or {})
                value = item.get("Raw") or item.get("Redacted") or "?"
                file = str(where.get("file") or where.get("path") or "?")
                key = (item.get("DetectorName"), value, file)
                if key in seen: continue
                seen.add(key)
                log(f"\\[*] [dim]#{ids[idx]}[/dim] Secret [bold yellow]{escape(str(item.get('DetectorName', '?')))}[/bold yellow] [bold red]{escape(str(value))}[/bold red] in [bold cyan]{escape(name)}[/bold cyan] {escape(file)}")
                idx += 1
            store.update(job_id, status="findings")
            stage(f"[bold red]{I_SKULL} {found} secrets[/bold red]")
        else:
            store.update(job_id, status="clean", report_path=str(report), error=None, download_path=None)
            stage(f"[green]{I_OK} clean[/green]")
        # Report and secrets are durable in SQLite; delete the APK to conserve space.
        try:
            path.unlink()
            store.update(job_id, download_path=None)
            log(f"#{job_id} [green]{I_OK} apk deleted[/green]")
        except OSError as e:
            store.update(job_id, error=str(e))
            log(f"#{job_id} [yellow]{I_WARN} apk cleanup failed[/yellow] {e}", kind="error")
    except Exception as e:
        retries = job["retries"] + 1
        status = "queued" if retries <= args.retries else "failed"
        if progress is not None and task_id is not None:
            progress.update(task_id, description=f"[bold yellow]{I_SYNC} {name} retry {retries}/{args.retries}[/bold yellow]")
        log(f"#{job_id} [bold yellow]{I_SYNC} {status}[/bold yellow] (retry {retries}/{args.retries}) {str(e)[:200]}", kind="error")
        store.update(job_id, status=status, retries=retries, error=str(e)[:500])
        if status == "queued":
            return process(store, fetch, {**dict(job), "retries": retries}, args, progress, task_id)


def import_files(store: Store, source: Path):
    files = [source] if source.is_file() else (p for suffix in ARCHIVE_SUFFIXES for p in source.glob(f"*{suffix}"))
    for file in files:
        if file.is_file() and file.suffix.lower() in ARCHIVE_SUFFIXES and zipfile.is_zipfile(file):
            sha = digest(file); target = store.root / "apks" / f"local-{sha}.apk"
            if not target.exists():
                part = target.with_suffix(".apk.part")
                shutil.copy2(file, part)
                if not zipfile.is_zipfile(part): part.unlink(missing_ok=True); continue
                part.replace(target)
            if store.add("local", f"local://{sha}", path=target): log(f"  [green]✓ queued[/green] local {file.name}")


def scan_loop(store: Store, fetch: Fetcher, args, stop_event=None):
    cycle = 0
    while True:
        if stop_event is not None and stop_event.is_set(): break
        cycle += 1
        console.rule(f"[bold cyan]{I_SYNC} cycle {cycle}[/bold cyan] [dim]{', '.join(args.source)}[/dim]")
        with Progress(SpinnerColumn(style="bold green"), TextColumn("[bold]{task.description}[/bold]"), BarColumn(bar_width=None), TextColumn("[dim]{task.percentage:>3.0f}%[/dim]"), TimeElapsedColumn(), console=console) as progress:
            tasks, futures = {}, []
            def submit(job):
                tasks[job["id"]] = progress.add_task(f"[cyan]{job['package'] or job['release_url']}[/cyan] {I_CLOCK} queued", total=3)
                futures.append(pool.submit(process, store, fetch, job, args, progress, tasks[job["id"]]))
            with ThreadPoolExecutor(max_workers=max(1, args.workers)) as pool:
                backlog = store.jobs()
                for job in backlog: submit(job)
                log(f"[bold]{I_LIST} {len(backlog)} job(s) queued for processing[/bold]")
                # Workers start immediately; releases join the live queue as each source discovers them.
                discovered = 0
                for job in discover(store, fetch, args):
                    if stop_event is not None and stop_event.is_set():
                        log(f"[yellow]{I_SYNC} discovery stopped, {discovered} release(s) queued this cycle[/yellow]")
                        break
                    discovered += 1
                    log(f"  [green]{I_OK} queued[/green] {job['source']} {job['package'] or job['release_url']} [dim]{job['version'] or ''}[/dim]")
                    submit(job)
                done = 0
                for future in as_completed(futures):
                    future.result(); done += 1
                    if stop_event is not None and stop_event.is_set():
                        for f in futures: f.cancel()
                        log(f"[yellow]{I_SYNC} scan stopped, {len(futures) - done} pending job(s) left queued[/yellow]")
                        break
        status_icons = {"clean": I_OK, "findings": I_SKULL, "failed": I_CROSS, "queued": I_LIST, "downloading": I_DOWN, "scanning": I_SEARCH}
        summary = ", ".join(f"{status_icons.get(row['status'], '•')} {row['status']}: {row['n']}" for row in store.counts())
        log(f"[bold]{I_OK} cycle {cycle} done[/bold] {summary}")
        console.rule(f"[bold]{I_OK} cycle {cycle} complete[/bold]")
        if not args.forever: break
        remaining = args.interval
        while remaining > 0:
            log(f"[dim]{I_CLOCK} next cycle in {remaining:g}s (Ctrl-C to stop)[/dim]")
            pause = min(max(1.0, args.interval / 6), remaining)
            if stop_event is not None:
                if stop_event.wait(pause): break
            else:
                time.sleep(pause)
            remaining -= pause

def _probe(url: str, headers=None, data=None):
    """(status, body) for a verification request; (None, b"") on network failure."""
    request = urllib.request.Request(url, headers={"User-Agent": "apksecrets/1.0 (+local secret scanner)", **(headers or {})}, data=data)
    try:
        with urllib.request.urlopen(request, timeout=VERIFY_TIMEOUT) as response:
            return response.status, response.read(8192)
    except urllib.error.HTTPError as e:
        return e.code, e.read(8192)
    except Exception:
        return None, b""

def _status(status, working, broken):
    if status is None or status == 429 or status >= 500: return None
    if status in working: return True
    if status in broken: return False
    return None


def _bearer(url, extra=None, working=(200,), broken=(401,)):
    return lambda value: _status(_probe(url, {"Authorization": "Bearer " + value, **(extra or {})})[0], working, broken)


def _bearer_post(url, data=b"{}", working=(200,), broken=(401,)):
    def verify(value):
        status, _ = _probe(url, {"Authorization": "Bearer " + value, "Content-Type": "application/json"}, data=data)
        return _status(status, working, broken)
    return verify


def _basic_auth(url, user="api", working=(200,), broken=(401, 403)):
    def verify(value):
        token = base64.b64encode(f"{user}:{value}".encode()).decode()
        status, _ = _probe(url, {"Authorization": "Basic " + token})
        return _status(status, working, broken)
    return verify


def _header_key(url, header, extra=None, working=(200,), broken=(401,)):
    return lambda value: _status(_probe(url, {header: value, **(extra or {})})[0], working, broken)


def _verify_slack(value):
    status, body = _probe("https://slack.com/api/auth.test", {"Authorization": "Bearer " + value})
    if status == 200:
        try: return bool(json.loads(body or b"{}").get("ok"))
        except ValueError: return None
    return _status(status, (), (401,))


def _verify_telegram(value):
