def _verify_google_key(value):
    """AIza keys are shared Google API keys: 400/403 on Gemini may just mean the
    key is restricted or Gemini is disabled for its project — the same string
    often stays live for Firebase/Maps, so cross-check before calling it broken."""
    key = urllib.parse.quote(value)
    status, _ = _probe("https://generativelanguage.googleapis.com/v1beta/models?key=" + key)
    if _status(status, (200, 429), ()) is True: return True
    if _status(status, (), (400, 403)) is not False: return None  # network, rate limit or outage
    status, _ = _probe("https://identitytoolkit.googleapis.com/v1/projects?key=" + key)
    if status == 200: return True  # live Firebase web key
    if _status(status, (), (400,)) is False: return False  # Google rejects the key itself
    status, body = _probe("https://maps.googleapis.com/maps/api/geocode/json?latlng=0,0&key=" + key)
    if status == 200:
        try: verdict = json.loads(body or b"{}")
        except ValueError: return None
        if verdict.get("status") in ("OK", "ZERO_RESULTS"): return True  # live Maps key
        message = str(verdict.get("error_message", "")).lower()
        if verdict.get("status") == "REQUEST_DENIED" and ("invalid" in message or "expired" in message): return False
    return None  # key resolves to a real project but nothing reachable accepts it


