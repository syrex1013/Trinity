def _verify_aws(value):
    """AKIA/ASIA access keys, verified with a SigV4-signed sts:GetCallerIdentity call."""
    raw = value.strip()
    if ":" in raw: parts = raw.split(":")
    elif re.fullmatch(r"(?:AKIA|ASIA)[0-9A-Z]{16}[A-Za-z0-9/+=]{40}", raw): parts = [raw[:20], raw[20:]]
    else: return None
    if len(parts) not in (2, 3) or not re.fullmatch(r"(?:AKIA|ASIA)[0-9A-Z]{16}", parts[0]) or not re.fullmatch(r"[A-Za-z0-9/+=]{40}", parts[1]): return None
    access, secret = parts[0], parts[1]
    token = parts[2] if len(parts) == 3 else None
    now = time.gmtime()
    amz_date, datestamp = time.strftime("%Y%m%dT%H%M%SZ", now), time.strftime("%Y%m%d", now)
    host = "sts.amazonaws.com"
    scope = f"{datestamp}/us-east-1/sts/aws4_request"
    query = "Action=GetCallerIdentity&Version=2011-06-15"
    headers = {"host": host, "x-amz-date": amz_date}
    if token: headers["x-amz-security-token"] = token
    canonical = "\n".join(["GET", "/", query, "&".join(f"{k}:{headers[k]}" for k in sorted(headers)), "", ";".join(sorted(headers)), hashlib.sha256(b"").hexdigest()])
    to_sign = "\n".join(["AWS4-HMAC-SHA256", amz_date, scope, hashlib.sha256(canonical.encode()).hexdigest()])
    key = hmac.new(("AWS4" + secret).encode(), datestamp.encode(), hashlib.sha256).digest()
    for part in ("us-east-1", "sts", "aws4_request"): key = hmac.new(key, part.encode(), hashlib.sha256).digest()
    signature = hmac.new(key, to_sign.encode(), hashlib.sha256).hexdigest()
    auth = f"AWS4-HMAC-SHA256 Credential={access}/{scope}, SignedHeaders={';'.join(sorted(headers))}, Signature={signature}"
    extra = {"Authorization": auth, "X-Amz-Date": amz_date}
    if token: extra["X-Amz-Security-Token"] = token
    status, _ = _probe(f"https://{host}/?{query}", extra)
    return _status(status, (200,), (400, 403))



