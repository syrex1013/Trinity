); CREATE INDEX IF NOT EXISTS jobs_status ON jobs(status);"""
SECRETS_SCHEMA = """CREATE TABLE IF NOT EXISTS secrets (
 id INTEGER PRIMARY KEY, job_id INTEGER NOT NULL REFERENCES jobs(id),
