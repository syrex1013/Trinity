console = Console(highlight=False)
_log_buffer = []
_log_lock = threading.Lock()
_log_seq = 0


def log(message: str) -> None:
    global _log_seq
    with _log_lock:
        _log_seq += 1
        entry = {"seq": _log_seq, "time": time.strftime("%H:%M:%S"), "text": message}
        _log_buffer.append(entry)
        if len(_log_buffer) > 2000: del _log_buffer[:len(_log_buffer) - 2000]
    console.print(f"[dim]{entry['time']}[/dim] {message}")

# MesloLGS Nerd Font glyphs
I_SEARCH, I_DOWN, I_BOX, I_KEY = "", "", "", ""
I_OK, I_CROSS, I_SYNC, I_WARN = "", "", "", ""
I_CLOCK, I_LIST, I_FOLDER, I_COG, I_SKULL = "", "", "", "", ""
